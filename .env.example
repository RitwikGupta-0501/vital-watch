# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here
DOCTOR_INVITE_CODE=doctor_secret_invite_code_2026
ADMIN_INVITE_CODE=admin_secret_invite_code_2026

# Application Configuration
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://d11ox9eozk6am1.cloudfront.net

# Storage Provider Configuration: "local" (default for offline dev) or "s3"
STORAGE_PROVIDER=local
LOCAL_STORAGE_BASE_URL=http://localhost:8080
LOCAL_STORAGE_SECRET=optional_dedicated_storage_signing_secret_here

# AWS S3 Configuration (Required if STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-vital-watch-bucket

# Database Configuration
# Option A: individual vars (password is URL-encoded automatically)
DB_HOST=localhost
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=apppassword
DB_NAME=appdb
DB_SSLMODE=disable

# Option B: full connection URL (takes priority over individual DB_* vars above)
# Useful for cloud platforms that inject DATABASE_URL directly (Supabase, Neon, Heroku, ECS).
# DATABASE_URL=postgres://appuser:apppassword@localhost:5432/appdb?sslmode=disable

# Connection pool sizing (optional — sensible defaults are built in)
# Budget: HTTP(~40) + River workers(12) + Auditor(5) + SSE LISTEN(1) + buffer(17) = 75
DB_MAX_CONNS=75
DB_MIN_CONNS=10

# Migration control
# Set AUTO_MIGRATE=false for multi-replica deployments where a dedicated
# migration initContainer or CI job manages schema changes instead.
AUTO_MIGRATE=true

