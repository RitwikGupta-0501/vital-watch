+func (b *SSEBroker) listenForNotifications() {
+	for {
+		if b.ctx.Err() != nil {
+			return
+		}
+
+		conn, err := b.pool.Acquire(b.ctx)
+		if err != nil {
+			if errors.Is(err, context.Canceled) {
+				return
